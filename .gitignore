# Environment & secrets — .env.example is the committed template, never ignore it
.env
.env.*
!.env.example
*.env.local

# Bulk local data — never committed (data/README.md explains what goes here and how to get it)
data/*
!data/README.md

# Legacy RxDis reference material — kept locally, not part of the new app's history
reference/rxdis-legacy/output/
reference/rxdis-legacy/.env.rxdis-legacy

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
*.cover

# Virtual environments
.venv/
venv/
env/

# Node / frontend
node_modules/
.next/
out/

# Go
bin/
*.exe

# Mattermost server build/runtime artifacts (once vendored in Phase 0 of the build plan)
mattermost-server/dist/
mattermost-server/data/
mattermost-server/logs/
mattermost-server/config/config.json

# Databases & large data files (scoped to data/ and .duckdb specifically —
# NOT a blanket *.sql, which would also hide tracked files like
# mattermost-server/init-databases.sql)
*.db
*.sqlite
*.sqlite3
*.duckdb
data/*.sql

# Notebooks checkpoints
.ipynb_checkpoints/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Serena MCP's semantic-code-index cache (auto-generated, machine-specific)
.serena/

# OS
.DS_Store
Thumbs.db

# Logs & temp
*.log
*.tmp
tmp/
logs/
