# Copy to .env and fill in real values. .env is gitignored -- never commit it.

POSTGRES_PASSWORD=change_me_before_anything_but_local_dev

# First-run Mattermost bootstrap (scripts/bootstrap_mattermost.py -- pure
# Python stdlib, run as `python scripts/bootstrap_mattermost.py` the same
# way on Mac, Linux, and Windows) -- creates the initial admin account, a
# team, and a test bot on a fresh instance.
MM_ADMIN_EMAIL=admin@example.com
MM_ADMIN_USERNAME=admin
# Leave blank. bootstrap_mattermost.py generates a random password on first
# run, writes it back here, and prints it once -- never a shared default
# anyone who's read this file could log in with.
MM_ADMIN_PASSWORD=
MM_TEAM_NAME=openbiolab
MM_TEAM_DISPLAY_NAME="OpenBioLab"

# Orchestrator Service
# Optional -- only needed if you're authenticating the `claude` CLI with an
# Anthropic API key. If you have a Claude subscription (Pro/Max) instead and
# no API key, leave this blank: run `docker compose exec orchestrator claude
# login` once after first starting the stack, and skip this entirely -- see
# docker-compose.yml's orchestrator service comment for details.
ANTHROPIC_API_KEY=
MATTERMOST_URL=http://localhost:8065
ORCHESTRATOR_DB_URL=postgresql+asyncpg://aiscientist:change_me_before_anything_but_local_dev@localhost:5432/orchestrator
# Shared secret Mattermost's Outgoing Webhook config must send back so the
# Orchestrator can verify a call actually came from this Mattermost instance.
# Mattermost generates this token itself when you create the Outgoing
# Webhook (POST /api/v4/hooks/outgoing) -- copy the "token" field from that
# response here. You cannot choose this value yourself.
MATTERMOST_WEBHOOK_SECRET=

# Credential vault master key (docs/07-system-architecture.md -- exact
# key-management mechanism still a Phase 2 decision; placeholder for now)
CREDENTIAL_VAULT_KEY=

# Flat, one-DOI-per-line Sci-Hub archive index (app/tools/literature_discovery.py).
# Default assumes the recovered data/ layout; override if yours lives elsewhere.
SCIHUB_DOI_INDEX_PATH=

# Base URL for full-report links the Orchestrator posts into Mattermost
# (a human clicks these from their own browser) -- defaults to localhost,
# override if the Orchestrator is reachable elsewhere for your setup.
ORCHESTRATOR_PUBLIC_URL=

# Full-text acquisition (app/tools/literature_discovery.py download_paper):
# Camofox stealth headless browser (https://github.com/jo-inc/camofox-browser),
# e.g. http://localhost:9377
CAMOFOX_API_URL=
# Only needed if the Camofox server itself has CAMOFOX_ACCESS_KEY set --
# sent back as `Authorization: Bearer <key>`. Leave blank for a
# loopback-only/no-auth Camofox deployment.
CAMOFOX_ACCESS_KEY=
# Comma-separated Sci-Hub mirrors Camofox tries in order (mirrors go
# down/get blocked at any given time -- list every working one you have).
SCIHUB_MIRROR_URLS=https://sci-hub.se,https://sci-hub.ren,https://sci-hub.st
